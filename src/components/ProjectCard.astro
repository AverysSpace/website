---
const { project } = Astro.props;
---
<article class:list={['project-card', project.featured && 'project-featured']} data-reveal>
  <div class="project-top">
    <div class:list={['project-icon', project.slug]}>{project.icon}</div>
    <div class="project-heading">
      <h3><a href={`/projects/${project.slug}`}>{project.name}</a></h3>
      <span class:list={['status', project.statusClass]}><i></i>{project.status}</span>
    </div>
  </div>
  <p class="project-description">{project.description}</p>
  <div class="tag-list">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div>
  <div class="project-meta">
    <a class="text-link" href={`https://github.com/${project.repo}`} target="_blank" rel="noreferrer"><span class="github-mini">GH</span> View repo ↗</a>
    <a class="release-link" href="/releases"><span class="cube">◇</span> <span data-release-version={project.repo}>Latest release</span></a>
  </div>
</article>

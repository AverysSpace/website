---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.js';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.name} — AVERY`} description={project.description}>
  <section class="page-hero section-wrap">
    <a class="back-link" href="/projects">← ALL PROJECTS</a>
    <p class="eyebrow"><span class="prompt">›_</span> PROJECT / {project.slug.toUpperCase()}</p>
    <h1>{project.name}<span class="red">_</span></h1>
    <p>{project.longDescription}</p>
    <div class="tag-list page-tags">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div>
    <div class="hero-actions">
      <a class="button button-primary" href={`https://github.com/${project.repo}`} target="_blank" rel="noreferrer">View source on GitHub ↗</a>
      <a class="button button-secondary" href={`https://github.com/${project.repo}/releases`} target="_blank" rel="noreferrer">Releases ↗</a>
    </div>
  </section>
  <section class="section-wrap detail-grid">
    <article class="detail-panel"><span class="section-index">[ OVERVIEW ]</span><h2>About this project</h2><p>{project.longDescription}</p><p>For current features, installation instructions, and technical details, see the project repository.</p></article>
    <aside class="detail-panel"><span class="section-index">[ PROJECT INFO ]</span><dl><dt>Status</dt><dd><span class:list={['status', project.statusClass]}><i></i>{project.status}</span></dd><dt>Repository</dt><dd><a class="text-link" href={`https://github.com/${project.repo}`} target="_blank" rel="noreferrer">{project.repo} ↗</a></dd><dt>Technologies</dt><dd class="tag-list">{project.tags.map(tag => <span class="tag">{tag}</span>)}</dd></dl></aside>
  </section>
</BaseLayout>
